import { Button, CheckBox, LineEdit, ListView, ScrollView, Slider } from "std-widgets.slint";
import { OverlayStatHeader, OverlayStatValue, OverlayEditorButton } from "overlay-style.slint";

export struct OverlayColumnUi {
    id: string,
    title: string,
    full-title: string,
    group: string,
    icon: image,
    column-width: float,
}

export struct OverlayCellUi {
    text: string,
    value-color: color,
}

export struct OverlayRowUi {
    name: string,
    name-color: color,
    cells: [OverlayCellUi],
}

export struct PlayerUiRow {
    visible: bool,
    name: string,
    color-index: int,
    color-name: string,
    gold: int,
    wood: int,
    stone: int,
    food-stock: int,
    food-ratio-text: string,
    tax-text: string,
    total-effect-text: string,
    popularity-text: string,
    popularity: int,
    popularity-color: color,
    population: int,
    army: int,
    buildings: int,
    traps: int,
    ff: int,
    ha: int,
    skirmishers: int,
    archers: int,
    xbows: int,
    arab-bows: int,
    slingers: int,
    camel-lancers: int,
    shields: int,
    catapults: int,
    workshops: int,
    shooters: int,
    army-killed: int,
    army-lost: int,
    knights: int,
    extreme-power: int,
    ff-text: string,
    stat-gold-earned: int,
    stat-food-produced: int,
    stat-wood-produced: int,
    stat-stone-produced: int,
    stat-iron-produced: int,
    stat-weapons-produced: int,
}

export struct SteamIdUiRow {
    player-id: int,
    name: string,
    color-index: int,
    steam-id: string,
    profile-url: string,
}

export struct HistoryGameUiRow {
    id: string,
    date: string,
    map: string,
    duration: string,
    status: string,
    players: string,
    source: string,
}

export struct JournalPlayerUiRow {
    steam-id: string,
    name: string,
    color-index: int,
    aliases: string,
    games: int,
    last-seen: string,
    profile-url: string,
}

export struct HistoryFieldUiRow {
    label: string,
    value: string,
    group: string,
    steam-id: string,
}

export struct HistoryRosterUiRow {
    slot: int,
    name: string,
    steam-id: string,
    color-index: int,
    team: string,
    gold: string,
    population: string,
    army: string,
    kills: string,
    losses: string,
    acquired-gold: string,
    food-produced: string,
    weapons-produced: string,
}

component FieldLabel inherits Text {
    color: #3b4352;
    font-size: 12px;
    font-weight: 600;
    vertical-alignment: center;
}

component ValueText inherits Text {
    color: #111827;
    font-size: 12px;
    horizontal-alignment: right;
    vertical-alignment: center;
}

component TableHeaderText inherits FieldLabel {
    in property <length> column_width: 52px;
    width: root.column_width;
    horizontal-alignment: right;
}

component TableGroupText inherits FieldLabel {
    in property <length> group_width: 120px;
    width: root.group_width;
    height: 18px;
    color: #647084;
    font-size: 11px;
    horizontal-alignment: center;
}

component TableValueText inherits ValueText {
    in property <length> column_width: 52px;
    width: root.column_width;
}

component CompactValue inherits Text {
    in property <float> overlay_font_size: 16;
    color: #f8fafc;
    font-size: root.overlay_font_size * 1px;
    font-weight: 700;
    horizontal-alignment: right;
    vertical-alignment: center;
}

component CompactLabel inherits Text {
    in property <float> overlay_font_size: 16;
    color: #cbd5e1;
    font-size: max(9px, root.overlay_font_size * 0.62px);
    font-weight: 600;
    horizontal-alignment: left;
    vertical-alignment: center;
}

component SettingsRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    height: 30px;

    FieldLabel {
        text: root.label;
        width: 98px;
    }
}

component StatToggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <length> box_width: 125px;

    width: root.box_width;
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.checked ? #0b65c9 : #cfd7e5;
    background: root.checked ? #0b65c9 : #f8fafc;

    Text {
        text: root.text;
        color: root.checked ? #ffffff : #111827;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
        }
    }
}

component SettingsTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <length> box_width: 180px;
    callback clicked();

    height: 28px;
    width: root.box_width;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.selected ? #0b65c9 : #cfd7e5;
    background: root.selected ? #0b65c9 : #f8fafc;

    Text {
        text: root.text;
        color: root.selected ? #ffffff : #111827;
        font-size: 12px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component PlayerConfigRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> player_name;
    in-out property <bool> enabled;
    in-out property <int> color_index;
    callback cycle_color();

    height: 26px;
    spacing: 6px;

    Rectangle {
        width: 42px;
        height: 24px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.enabled ? #0b65c9 : #cfd7e5;
        background: root.enabled ? #0b65c9 : #f8fafc;

        Text {
            text: root.label;
            color: root.enabled ? #ffffff : #111827;
            font-size: 11px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                root.enabled = !root.enabled;
            }
        }
    }

    LineEdit {
        text <=> root.player_name;
        width: 106px;
    }

    Rectangle {
        width: 58px;
        height: 26px;
        border-radius: 4px;
        border-width: 1px;
        border-color: #c7cedb;
        background: root.color_index == 1 ? #df3b30 :
            root.color_index == 2 ? #f28c28 :
            root.color_index == 3 ? #f2d447 :
            root.color_index == 4 ? #3b6eea :
            root.color_index == 5 ? #1d2430 :
            root.color_index == 6 ? #8e44d7 :
            root.color_index == 7 ? #58c7e8 :
            root.color_index == 8 ? #33a852 :
            #f8fafc;

        Text {
            text: root.color_index == 1 ? "Red" :
                root.color_index == 2 ? "Orange" :
                root.color_index == 3 ? "Yellow" :
                root.color_index == 4 ? "Blue" :
                root.color_index == 5 ? "Black" :
                root.color_index == 6 ? "Violet" :
                root.color_index == 7 ? "Sky" :
                root.color_index == 8 ? "Green" :
                "None";
            color: root.color_index == 3 ? #111827 : #ffffff;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                root.cycle_color();
            }
        }
    }
}

component PlayerTable inherits Rectangle {
    in property <[PlayerUiRow]> player_rows;

    border-radius: 6px;
    background: #ffffff;
    border-color: #dde3ee;
    border-width: 1px;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        VerticalLayout {
            width: 246px;
            spacing: 8px;

            HorizontalLayout {
                height: 18px;
                spacing: 8px;
                TableGroupText { text: ""; group_width: 118px; }
                TableGroupText { text: ""; group_width: 58px; }
                TableGroupText { text: ""; group_width: 54px; }
            }

            HorizontalLayout {
                height: 22px;
                spacing: 8px;
                FieldLabel { text: "Player"; width: 118px; }
                FieldLabel { text: "Color"; width: 58px; horizontal-alignment: center; }
                FieldLabel { text: "Overlay"; width: 54px; horizontal-alignment: center; }
            }

            for row in root.player_rows: HorizontalLayout {
                height: 28px;
                spacing: 8px;

                Text {
                    text: row.name;
                    width: 118px;
                    color: row.visible ? #111827 : #8a94a6;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: row.color-name;
                    width: 58px;
                    color: row.color-index == 1 ? #df3b30 :
                        row.color-index == 2 ? #f28c28 :
                        row.color-index == 3 ? #b69200 :
                        row.color-index == 4 ? #3b6eea :
                        row.color-index == 5 ? #111827 :
                        row.color-index == 6 ? #8e44d7 :
                        row.color-index == 7 ? #168aad :
                        row.color-index == 8 ? #33a852 :
                        #111827;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    text: row.visible ? "shown" : "hidden";
                    width: 54px;
                    color: row.visible ? #166534 : #8a94a6;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                width: 1808px;
                spacing: 8px;

                HorizontalLayout {
                    height: 18px;
                    spacing: 8px;

                    TableGroupText { text: "Game stats"; group_width: 554px; }
                    TableGroupText { text: "Army"; group_width: 698px; }
                    TableGroupText { text: "Buildings"; group_width: 46px; }
                    TableGroupText { text: "Acquired resources"; group_width: 434px; }
                    TableGroupText { text: "Fear"; group_width: 36px; }
                }

                HorizontalLayout {
                    height: 22px;
                    spacing: 8px;

                    TableHeaderText { text: "Gold"; column_width: 70px; }
                    TableHeaderText { text: "Wood"; column_width: 52px; }
                    TableHeaderText { text: "Stone"; column_width: 52px; }
                    TableHeaderText { text: "Food"; column_width: 52px; }
                    TableHeaderText { text: "Pop"; column_width: 44px; }
                    TableHeaderText { text: "FoodFx"; column_width: 52px; }
                    TableHeaderText { text: "Tax"; column_width: 42px; }
                    TableHeaderText { text: "Popularity"; column_width: 80px; }
                    TableHeaderText { text: "Army"; column_width: 46px; }
                    TableHeaderText { text: "HA"; column_width: 38px; }
                    TableHeaderText { text: "CL"; column_width: 38px; }
                    TableHeaderText { text: "Knight"; column_width: 46px; }
                    TableHeaderText { text: "Skirm"; column_width: 48px; }
                    TableHeaderText { text: "Arch"; column_width: 42px; }
                    TableHeaderText { text: "ArabBow"; column_width: 58px; }
                    TableHeaderText { text: "Xbow"; column_width: 44px; }
                    TableHeaderText { text: "Sling"; column_width: 44px; }
                    TableHeaderText { text: "Shoot"; column_width: 48px; }
                    TableHeaderText { text: "Killed"; column_width: 62px; }
                    TableHeaderText { text: "Lost"; column_width: 48px; }
                    TableHeaderText { text: "Shield"; column_width: 52px; }
                    TableHeaderText { text: "Cata"; column_width: 42px; }
                    TableHeaderText { text: "Work"; column_width: 46px; }
                    TableHeaderText { text: "AcqGold"; column_width: 70px; }
                    TableHeaderText { text: "FoodPr"; column_width: 64px; }
                    TableHeaderText { text: "WeapPr"; column_width: 64px; }
                    TableHeaderText { text: "StonePr"; column_width: 68px; }
                    TableHeaderText { text: "IronPr"; column_width: 64px; }
                    TableHeaderText { text: "WoodPr"; column_width: 64px; }
                    TableHeaderText { text: "FF"; column_width: 36px; }
                }

                for row in root.player_rows: HorizontalLayout {
                    height: 28px;
                    spacing: 8px;

                    TableValueText { text: row.gold; column_width: 70px; }
                    TableValueText { text: row.wood; column_width: 52px; }
                    TableValueText { text: row.stone; column_width: 52px; }
                    TableValueText { text: row.food-stock; column_width: 52px; }
                    TableValueText { text: row.population; column_width: 44px; }
                    TableValueText { text: row.food-ratio-text; column_width: 52px; }
                    TableValueText { text: row.tax-text; column_width: 42px; }
                    TableValueText { text: row.popularity-text; column_width: 80px; }
                    TableValueText { text: row.army; column_width: 46px; }
                    TableValueText { text: row.ha; column_width: 38px; }
                    TableValueText { text: row.camel-lancers; column_width: 38px; }
                    TableValueText { text: row.knights; column_width: 46px; }
                    TableValueText { text: row.skirmishers; column_width: 48px; }
                    TableValueText { text: row.archers; column_width: 42px; }
                    TableValueText { text: row.arab-bows; column_width: 58px; }
                    TableValueText { text: row.xbows; column_width: 44px; }
                    TableValueText { text: row.slingers; column_width: 44px; }
                    TableValueText { text: row.shooters; column_width: 48px; }
                    TableValueText { text: row.army-killed; column_width: 62px; }
                    TableValueText { text: row.army-lost; column_width: 48px; }
                    TableValueText { text: row.shields; column_width: 52px; }
                    TableValueText { text: row.catapults; column_width: 42px; }
                    TableValueText { text: row.workshops; column_width: 46px; }
                    TableValueText { text: row.stat-gold-earned; column_width: 70px; }
                    TableValueText { text: row.stat-food-produced; column_width: 64px; }
                    TableValueText { text: row.stat-weapons-produced; column_width: 64px; }
                    TableValueText { text: row.stat-stone-produced; column_width: 68px; }
                    TableValueText { text: row.stat-iron-produced; column_width: 64px; }
                    TableValueText { text: row.stat-wood-produced; column_width: 64px; }
                    TableValueText { text: row.ff-text; column_width: 36px; }
                }
            }
        }
    }
}

component SteamIdLink inherits Rectangle {
    in property <string> steam-id;
    in property <bool> available: root.steam-id != "" && root.steam-id != "—" && root.steam-id != "Unavailable";
    callback open-profile(string);
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.steam-id != "" ? root.steam-id : "—";
        color: root.available ? #0b65c9 : #8a94a6;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        y: parent.height / 2 + 7px;
        width: min(parent.width, label.preferred-width);
        height: 1px;
        background: #0b65c9;
        visible: root.available && touch.has-hover;
    }
    touch := TouchArea {
        enabled: root.available;
        mouse-cursor: pointer;
        clicked => { root.open-profile(root.steam-id); }
    }
}

component SteamIdTable inherits Rectangle {
    in property <[SteamIdUiRow]> rows;
    in property <string> status;
    callback open-profile(int, string);

    border-radius: 6px;
    background: #ffffff;
    border-color: #dde3ee;
    border-width: 1px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: "Steam player IDs";
            color: #111827;
            font-size: 16px;
            font-weight: 800;
        }
        Text {
            text: root.status;
            color: #647084;
            font-size: 12px;
            wrap: word-wrap;
        }
        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            VerticalLayout {
                min-width: 450px;
                spacing: 4px;
                alignment: start;
                HorizontalLayout {
                    height: 28px;
                    spacing: 16px;
                    FieldLabel { text: "Player name"; width: 210px; }
                    FieldLabel { text: "SteamID64"; width: 168px; }
                    Rectangle { horizontal-stretch: 1; }
                }
                for row in root.rows: Rectangle {
                    height: 34px;
                    background: #f8fafc;
                    border-radius: 3px;
                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: row.name;
                            width: 210px;
                            color: row.color-index == 1 ? #df3b30 :
                                row.color-index == 2 ? #f28c28 :
                                row.color-index == 3 ? #b69200 :
                                row.color-index == 4 ? #3b6eea :
                                row.color-index == 5 ? #111827 :
                                row.color-index == 6 ? #8e44d7 :
                                row.color-index == 7 ? #168aad :
                                row.color-index == 8 ? #33a852 :
                                #111827;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        SteamIdLink {
                            steam-id: row.steam-id;
                            available: row.profile-url != "";
                            width: 168px;
                            open-profile(id) => { root.open-profile(row.player-id, id); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if root.rows.length == 0: Text {
                    text: "No Steam player IDs available. Open a multiplayer match, then refresh.";
                    color: #8a94a6;
                    font-size: 13px;
                    height: 44px;
                }
            }
        }
    }
}

component HistoryName inherits Text {
    in property <int> color-index;
    color: root.color-index == 1 ? #df3b30 :
        root.color-index == 2 ? #f28c28 :
        root.color-index == 3 ? #b69200 :
        root.color-index == 4 ? #3b6eea :
        root.color-index == 5 ? #111827 :
        root.color-index == 6 ? #8e44d7 :
        root.color-index == 7 ? #168aad :
        root.color-index == 8 ? #33a852 : #111827;
    font-size: 13px;
    font-weight: 700;
    vertical-alignment: center;
    overflow: elide;
}

component HistoryText inherits Text {
    color: #111827;
    font-size: 12px;
    vertical-alignment: center;
    overflow: elide;
}

component HistoryGamesTable inherits Rectangle {
    in property <[HistoryGameUiRow]> rows;
    callback open-game(string);
    background: #ffffff;
    border-color: #dde3ee;
    border-width: 1px;
    border-radius: 4px;
    clip: true;
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 34px;
            background: #f1f5f9;
            clip: true;
            HorizontalLayout {
                x: list.viewport-x;
                width: list.viewport-width;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;
                FieldLabel { text: "Date / map"; width: 250px; }
                FieldLabel { text: "Players"; horizontal-stretch: 1; }
                FieldLabel { text: "Duration"; width: 75px; }
                FieldLabel { text: "Status"; width: 100px; }
                FieldLabel { text: "Source"; width: 90px; }
            }
        }
        list := ListView {
            viewport-width: max(self.visible-width, 790px);
            for row[index] in root.rows: Rectangle {
                width: list.viewport-width;
                height: 47px;
                background: touch.has-hover ? #eaf1fa : mod(index, 2) == 0 ? #ffffff : #f8fafc;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 12px;
                    VerticalLayout {
                        width: 250px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 0px;
                        HistoryText { text: row.date; font-weight: 700; }
                        HistoryText { text: row.map; color: #647084; font-size: 11px; }
                    }
                    HistoryText { text: row.players; horizontal-stretch: 1; }
                    HistoryText { text: row.duration; width: 75px; }
                    HistoryText { text: row.status; width: 100px; }
                    HistoryText { text: row.source; width: 90px; color: #647084; }
                }
                touch := TouchArea {
                    enabled: row.id != "";
                    mouse-cursor: pointer;
                    clicked => { root.open-game(row.id); }
                }
            }
        }
    }
    if root.rows.length == 0: HistoryText {
        x: 16px;
        y: 60px;
        width: parent.width - 32px;
        text: "No recorded games match these filters.";
        color: #647084;
        wrap: word-wrap;
    }
}

component JournalPlayersTable inherits Rectangle {
    in property <[JournalPlayerUiRow]> rows;
    callback open-player(string);
    callback open-profile(string);
    background: #ffffff;
    border-color: #dde3ee;
    border-width: 1px;
    border-radius: 4px;
    clip: true;
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 34px;
            background: #f1f5f9;
            clip: true;
            HorizontalLayout {
                x: list.viewport-x;
                width: list.viewport-width;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;
                FieldLabel { text: "Player / known nicknames"; min-width: 260px; horizontal-stretch: 1; }
                FieldLabel { text: "SteamID64"; width: 168px; }
                FieldLabel { text: "Games"; width: 64px; horizontal-alignment: right; }
                FieldLabel { text: "Last recorded"; width: 140px; }
            }
        }
        list := ListView {
            viewport-width: max(self.visible-width, 740px);
            for row[index] in root.rows: Rectangle {
                width: list.viewport-width;
                height: 48px;
                background: touch.has-hover ? #eaf1fa : mod(index, 2) == 0 ? #ffffff : #f8fafc;
                touch := TouchArea {
                    enabled: row.steam-id != "";
                    mouse-cursor: pointer;
                    clicked => { root.open-player(row.steam-id); }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 12px;
                    VerticalLayout {
                        min-width: 260px;
                        horizontal-stretch: 1;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 0px;
                        HistoryName { text: row.name; color-index: row.color-index; }
                        HistoryText { text: row.aliases; color: #647084; font-size: 11px; }
                    }
                    SteamIdLink {
                        steam-id: row.steam-id;
                        available: row.profile-url != "";
                        width: 168px;
                        open-profile(id) => { root.open-profile(id); }
                    }
                    HistoryText { text: row.games; width: 64px; horizontal-alignment: right; }
                    HistoryText { text: row.last-seen; width: 140px; }
                }
            }
        }
    }
    if root.rows.length == 0: HistoryText {
        x: 16px;
        y: 60px;
        width: parent.width - 32px;
        text: "No players match this search. Update the player journal to read saved games.";
        color: #647084;
        wrap: word-wrap;
    }
}

component HistoryFields inherits VerticalLayout {
    in property <[HistoryFieldUiRow]> fields;
    callback open-profile(string);
    spacing: 1px;
    for field[index] in root.fields: Rectangle {
        private property <bool> starts-group: index == 0 || root.fields[index - 1].group != field.group;
        height: (self.starts-group ? 30px : 0px) + max(40px, value-text.preferred-height + 12px);
        background: #f8fafc;
        if self.starts-group: Text {
            x: 10px;
            y: 6px;
            text: field.group;
            color: #647084;
            font-size: 11px;
            font-weight: 700;
        }
        FieldLabel {
            x: 10px;
            y: parent.starts-group ? 30px : 0px;
            width: 180px;
            height: parent.height - self.y;
            text: field.label;
        }
        value-text := Text {
            x: 205px;
            y: (parent.starts-group ? 30px : 0px) + 6px;
            width: max(50px, parent.width - 215px);
            height: self.preferred-height;
            text: field.value;
            color: #111827;
            font-size: 12px;
            wrap: word-wrap;
            visible: field.steam-id == "";
        }
        if field.steam-id != "": SteamIdLink {
            x: 205px;
            y: (parent.starts-group ? 30px : 0px);
            width: min(168px, parent.width - 215px);
            height: parent.height - self.y;
            steam-id: field.steam-id;
            open-profile(id) => { root.open-profile(id); }
        }
    }
}

component HistoryRosterTable inherits Rectangle {
    in property <[HistoryRosterUiRow]> rows;
    callback open-player(string);
    callback open-profile(string);
    height: max(90px, root.rows.length * 35px + 60px);
    border-width: 1px;
    border-color: #dde3ee;
    background: #ffffff;
    clip: true;
    scroll := ScrollView {
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: max(self.visible-width, 1340px);
        viewport-height: self.visible-height;
        VerticalLayout {
            x: 0px;
            y: 0px;
            width: scroll.viewport-width;
            height: root.rows.length * 35px + 36px;
            spacing: 0px;
            alignment: start;
            HorizontalLayout {
                height: 36px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;
                FieldLabel { text: "Slot"; width: 36px; }
                FieldLabel { text: "Player"; width: 190px; }
                FieldLabel { text: "SteamID64"; width: 168px; }
                FieldLabel { text: "Team"; width: 58px; }
                FieldLabel { text: "Gold"; width: 70px; horizontal-alignment: right; }
                FieldLabel { text: "Civilians"; width: 70px; horizontal-alignment: right; }
                FieldLabel { text: "Army"; width: 65px; horizontal-alignment: right; }
                FieldLabel { text: "Kills"; width: 65px; horizontal-alignment: right; }
                FieldLabel { text: "Losses"; width: 65px; horizontal-alignment: right; }
                FieldLabel { text: "Gold acquired"; width: 98px; horizontal-alignment: right; }
                FieldLabel { text: "Food produced"; width: 98px; horizontal-alignment: right; }
                FieldLabel { text: "Weapons"; width: 86px; horizontal-alignment: right; }
            }
            for row[index] in root.rows: Rectangle {
                height: 35px;
                background: mod(index, 2) == 0 ? #f8fafc : #ffffff;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 12px;
                    HistoryText { text: "P" + row.slot; width: 36px; }
                    Rectangle {
                        width: 190px;
                        HistoryName { text: row.name; color-index: row.color-index; width: parent.width; height: parent.height; }
                        TouchArea { enabled: row.steam-id != ""; mouse-cursor: pointer; clicked => { root.open-player(row.steam-id); } }
                    }
                    SteamIdLink { steam-id: row.steam-id; width: 168px; open-profile(id) => { root.open-profile(id); } }
                    HistoryText { text: row.team; width: 58px; }
                    HistoryText { text: row.gold; width: 70px; horizontal-alignment: right; }
                    HistoryText { text: row.population; width: 70px; horizontal-alignment: right; }
                    HistoryText { text: row.army; width: 65px; horizontal-alignment: right; }
                    HistoryText { text: row.kills; width: 65px; horizontal-alignment: right; }
                    HistoryText { text: row.losses; width: 65px; horizontal-alignment: right; }
                    HistoryText { text: row.acquired-gold; width: 98px; horizontal-alignment: right; }
                    HistoryText { text: row.food-produced; width: 98px; horizontal-alignment: right; }
                    HistoryText { text: row.weapons-produced; width: 86px; horizontal-alignment: right; }
                }
            }
        }
    }
}

component HistoryWorkspace inherits Rectangle {
    in property <int> view;
    in-out property <string> search;
    in-out property <int> filter: 0;
    in property <[HistoryGameUiRow]> games;
    in property <[JournalPlayerUiRow]> players;
    in property <string> list-status;
    in property <string> detail-title;
    in property <string> detail-summary;
    private property <bool> details-expanded: false;
    in property <[HistoryFieldUiRow]> detail-fields;
    in property <[HistoryRosterUiRow]> roster;
    in property <[string]> known-names;
    in property <[HistoryGameUiRow]> player-games;
    in property <string> detail-steam-id;
    callback show(int);
    callback search-changed(string);
    callback filter-changed(int);
    callback open-game(string);
    callback open-player(string);
    callback open-profile(string);
    callback refresh();
    background: #ffffff;
    border-color: #dde3ee;
    border-width: 1px;
    border-radius: 6px;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Button {
                text: root.view == 3 ? "‹ Games" : root.view == 4 ? "‹ Players" : "‹ SteamID";
                width: 100px;
                clicked => { root.show(root.view == 3 ? 1 : root.view == 4 ? 2 : 0); }
            }
            Text {
                text: root.view == 1 ? "Recorded games" : root.view == 2 ? "Player journal" : root.detail-title;
                color: #111827;
                font-size: 16px;
                font-weight: 800;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { text: "Refresh"; width: 80px; clicked => { root.refresh(); } }
        }
        if root.view == 1 || root.view == 2: HorizontalLayout {
            height: 30px;
            spacing: 8px;
            LineEdit {
                text <=> root.search;
                horizontal-stretch: 1;
                placeholder-text: root.view == 1 ? "Search map, player nickname or SteamID…" : "Search every recorded nickname or SteamID…";
                edited(value) => { root.search-changed(value); }
            }
            Button {
                text: "Clear";
                width: 64px;
                enabled: root.search != "";
                clicked => { root.search = ""; root.search-changed(""); }
            }
        }
        if root.view == 1: HorizontalLayout {
            height: 28px;
            spacing: 6px;
            for label[index] in ["All", "Finished", "Interrupted", "Recording"]: SettingsTabButton {
                text: label;
                box_width: 102px;
                selected: root.filter == index;
                clicked => { root.filter = index; root.filter-changed(index); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.view == 1: HistoryGamesTable { rows: root.games; open-game(id) => { root.open-game(id); } }
        if root.view == 2: JournalPlayersTable {
            rows: root.players;
            open-player(id) => { root.open-player(id); }
            open-profile(id) => { root.open-profile(id); }
        }
        if root.view == 3: ScrollView {
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                HistoryText { text: root.detail-summary; wrap: word-wrap; height: 42px; }
                FieldLabel { text: "Recorded roster and statistics"; height: 25px; }
                HistoryRosterTable {
                    rows: root.roster;
                    open-player(id) => { root.open-player(id); }
                    open-profile(id) => { root.open-profile(id); }
                }
                Button {
                    text: root.details-expanded ? "Hide setup and recording details" : "Show setup and recording details";
                    height: 28px;
                    clicked => { root.details-expanded = !root.details-expanded; }
                }
                if root.details-expanded: HistoryFields { fields: root.detail-fields; open-profile(id) => { root.open-profile(id); } }
            }
        }
        if root.view == 4: ScrollView {
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                HorizontalLayout {
                    height: 30px;
                    spacing: 10px;
                    FieldLabel { text: "SteamID64"; width: 90px; }
                    SteamIdLink { steam-id: root.detail-steam-id; width: 168px; open-profile(id) => { root.open-profile(id); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HistoryText { text: root.detail-summary; wrap: word-wrap; height: 42px; }
                FieldLabel { text: "All recorded nicknames"; height: 25px; }
                for name in root.known-names: HistoryText { text: name; height: 25px; }
                FieldLabel { text: "Recorded games with this player"; height: 25px; }
                HistoryGamesTable {
                    height: max(120px, min(450px, root.player-games.length * 47px + 40px));
                    rows: root.player-games;
                    open-game(id) => { root.open-game(id); }
                }
                Button {
                    text: root.details-expanded ? "Hide player statistics" : "Show player statistics";
                    height: 28px;
                    clicked => { root.details-expanded = !root.details-expanded; }
                }
                if root.details-expanded: HistoryFields { fields: root.detail-fields; open-profile(id) => { root.open-profile(id); } }
            }
        }
        HistoryText { text: root.list-status; color: #647084; height: 22px; }
    }
}

export component AppWindow inherits Window {
    in-out property <string> player1_name: "Player 1";
    in-out property <string> player2_name: "Player 2";
    in-out property <string> player3_name: "Player 3";
    in-out property <string> player4_name: "Player 4";
    in-out property <string> player5_name: "Player 5";
    in-out property <string> player6_name: "Player 6";
    in-out property <string> player7_name: "Player 7";
    in-out property <string> player8_name: "Player 8";
    in-out property <int> player1_color: 1;
    in-out property <int> player2_color: 2;
    in-out property <int> player3_color: 3;
    in-out property <int> player4_color: 4;
    in-out property <int> player5_color: 5;
    in-out property <int> player6_color: 6;
    in-out property <int> player7_color: 7;
    in-out property <int> player8_color: 8;
    in-out property <string> tournament_title: "Title";
    in-out property <string> match_label: "Description (score, etc.)";
    in-out property <float> panel_opacity: 0.78;
    in-out property <float> overlay_font_size: 16;
    in-out property <float> timer_panel_opacity: 0.78;
    in-out property <float> timer_font_size: 16;
    in-out property <float> game_speed: 50;
    in-out property <int> timer_player_id: 1;
    in-out property <float> heavy_refresh_interval_ms: 200;
    in-out property <bool> overlay_frame: true;
    in-out property <bool> timer_frame: true;
    in-out property <bool> timer_show_buildings: false;
    in-out property <bool> pin_on_top: true;
    in-out property <bool> admin_mode: false;
    in-out property <string> admin_key_input: "";
    in-out property <bool> admin_frame: true;
    in-out property <int> admin_game_player_id: 1;
    in-out property <int> admin_ui_player_id: 1;
    in-out property <int> settings_tab: 0;
    in-out property <bool> show_player1: true;
    in-out property <bool> show_player2: true;
    in-out property <bool> show_player3: true;
    in-out property <bool> show_player4: true;
    in-out property <bool> show_player5: false;
    in-out property <bool> show_player6: false;
    in-out property <bool> show_player7: false;
    in-out property <bool> show_player8: false;
    in-out property <bool> show_gold: true;
    in-out property <bool> show_population: true;
    in-out property <bool> show_army: true;
    in-out property <bool> show_food_effect: true;
    in-out property <bool> show_tax_effect: true;
    in-out property <bool> show_ha: true;
    in-out property <bool> show_cl: true;
    in-out property <bool> show_shooters: false;
    in-out property <bool> show_acq_gold: false;
    in-out property <bool> show_prod_weapons: false;
    in-out property <bool> show_prod_food: false;
    in-out property <bool> show_prod_stone: false;
    in-out property <bool> show_prod_iron: false;
    in-out property <bool> show_prod_wood: false;
    in-out property <bool> show_total_effect: false;
    in-out property <bool> show_knights: true;
    in-out property <bool> show_ff: false;
    in-out property <bool> show_army_killed: false;
    in-out property <bool> show_army_lost: false;
    in-out property <bool> shooter_count_skirmishers: false;
    in-out property <bool> shooter_count_archers: false;
    in-out property <bool> shooter_count_xbows: false;
    in-out property <bool> shooter_count_arab_bows: false;
    in-out property <bool> shooter_count_slingers: false;
    in property <string> process_status: "";
    in property <[PlayerUiRow]> player_rows;
    in property <[SteamIdUiRow]> steam_id_rows;
    in property <string> steam_id_status: "Refresh to read the current multiplayer players.";
    in-out property <int> history_view: 0;
    in-out property <string> history_search;
    in-out property <int> history_filter: 0;
    in property <string> history_status;
    in property <string> history_list_status;
    in property <[HistoryGameUiRow]> game_history_rows;
    in property <[JournalPlayerUiRow]> player_journal_rows;
    in property <string> history_detail_title;
    in property <string> history_detail_summary;
    in property <string> history_current_summary;
    in property <[HistoryFieldUiRow]> history_detail_fields;
    in property <[HistoryRosterUiRow]> history_roster_rows;
    in property <[string]> history_player_names;
    in property <[HistoryGameUiRow]> history_player_games;
    in property <string> history_detail_steam_id;
    in property <bool> history_import_pending: false;
    in property <string> history_import_preview;

    callback show_overlay();
    callback hide_overlay();
    callback show_timer();
    callback hide_timer();
    callback show_admin();
    callback hide_admin();
    callback cycle_player_color(int);
    callback submit_admin_key(string);
    callback request_admin_ui_player(int);
    callback reattach_game();
    callback import_multiplayer_players();
    callback refresh_steam_ids();
    callback open_steam_profile(int, string);
    callback history_show(int);
    callback history_search_changed(string);
    callback history_filter_changed(int);
    callback history_open_game(string);
    callback history_open_player(string);
    callback history_open_player_profile(string);
    callback history_rebuild_players();
    callback history_refresh();
    callback history_open_folder();
    callback history_export();
    callback history_import();
    callback history_confirm_import();
    callback history_cancel_import();
    in property <string> player_import_status: "Click to load multiplayer names and colors. Manual edits remain available.";

    title: "Stronghold Crusader DE, Monitor";
    icon: @image-url("../assets/icon.png");
    background: #f4f7fb;
    preferred-width: 1460px;
    preferred-height: 900px;
    min-width: 1120px;
    min-height: 620px;

    Rectangle {
        background: #f4f7fb;

        HorizontalLayout {
            padding: 12px;
            spacing: 12px;

            VerticalLayout {
                width: 550px;
                spacing: 5px;

                    Text {
                        text: "Stronghold Crusader DE - Tools";
                        color: #101827;
                        font-size: 22px;
                        font-weight: 800;
                    }

                    Text {
                        text: root.process_status;
                        color: #4b5563;
                        font-size: 12px;
                    }

                    Rectangle {
                    border-radius: 6px;
                    background: #ffffff;
                    border-color: #dde3ee;
                    border-width: 1px;
                    height: 162px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 9px;

                        SettingsRow {
                            label: "Title";
                            LineEdit { text <=> root.tournament_title; }
                        }

                        SettingsRow {
                            label: "Description";
                            LineEdit { text <=> root.match_label; }
                        }

                        SettingsRow {
                            label: "Admin key";
                            HorizontalLayout {
                                spacing: 8px;

                                LineEdit {
                                    text <=> root.admin_key_input;
                                    input-type: InputType.password;
                                    placeholder-text: root.admin_mode ? "Admin mode unlocked" : "Enter admin key";
                                    enabled: !root.admin_mode;
                                    accepted(text) => {
                                        root.submit_admin_key(text);
                                        root.admin_key_input = "";
                                    }
                                }

                                Button {
                                    text: "Unlock";
                                    width: 76px;
                                    enabled: !root.admin_mode;
                                    clicked => {
                                        root.submit_admin_key(root.admin_key_input);
                                        root.admin_key_input = "";
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 28px;
                            spacing: 18px;

                            CheckBox {
                                text: "Always on top";
                                checked <=> root.pin_on_top;
                            }

                            Button {
                                text: "Reattach";
                                width: 84px;
                                clicked => {
                                    root.reattach_game();
                                }
                            }

                            FieldLabel {
                                text: root.admin_mode ? "Admin mode" : "Read-only mode";
                                color: root.admin_mode ? #b45309 : #166534;
                            }
                        }
                    }
                }

                    Rectangle {
                    border-radius: 6px;
                    background: #ffffff;
                    border-color: #dde3ee;
                    border-width: 1px;
                    height: 216px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 7px;

                        HorizontalLayout {
                            Text {
                                text: "Player slots";
                                color: #111827;
                                font-size: 14px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Read Steam names + colors";
                                clicked => { root.import_multiplayer_players(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 60px;

                            VerticalLayout {
                                spacing: 5px;
                                PlayerConfigRow { label: "P1"; player_name <=> root.player1_name; enabled <=> root.show_player1; color_index <=> root.player1_color; cycle_color => { root.cycle_player_color(1); } }
                                PlayerConfigRow { label: "P2"; player_name <=> root.player2_name; enabled <=> root.show_player2; color_index <=> root.player2_color; cycle_color => { root.cycle_player_color(2); } }
                                PlayerConfigRow { label: "P3"; player_name <=> root.player3_name; enabled <=> root.show_player3; color_index <=> root.player3_color; cycle_color => { root.cycle_player_color(3); } }
                                PlayerConfigRow { label: "P4"; player_name <=> root.player4_name; enabled <=> root.show_player4; color_index <=> root.player4_color; cycle_color => { root.cycle_player_color(4); } }
                            }

                            VerticalLayout {
                                spacing: 5px;
                                PlayerConfigRow { label: "P5"; player_name <=> root.player5_name; enabled <=> root.show_player5; color_index <=> root.player5_color; cycle_color => { root.cycle_player_color(5); } }
                                PlayerConfigRow { label: "P6"; player_name <=> root.player6_name; enabled <=> root.show_player6; color_index <=> root.player6_color; cycle_color => { root.cycle_player_color(6); } }
                                PlayerConfigRow { label: "P7"; player_name <=> root.player7_name; enabled <=> root.show_player7; color_index <=> root.player7_color; cycle_color => { root.cycle_player_color(7); } }
                                PlayerConfigRow { label: "P8"; player_name <=> root.player8_name; enabled <=> root.show_player8; color_index <=> root.player8_color; cycle_color => { root.cycle_player_color(8); } }
                            }
                        }
                        Text {
                            text: root.player_import_status;
                            color: #4b5563;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }

                    Rectangle {
                    border-radius: 6px;
                    background: #ffffff;
                    border-color: #dde3ee;
                    border-width: 1px;
                    height: 430px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        alignment: start;

                        HorizontalLayout {
                            height: 28px;
                            spacing: 8px;
                            SettingsTabButton {
                                text: "Overlay settings";
                                selected: root.settings_tab == 0;
                                box_width: root.admin_mode ? 123px : 167px;
                                clicked => { root.settings_tab = 0; }
                            }
                            SettingsTabButton {
                                text: "Game ticks timer";
                                selected: root.settings_tab == 1;
                                box_width: root.admin_mode ? 123px : 167px;
                                clicked => { root.settings_tab = 1; }
                            }
                            if root.admin_mode: SettingsTabButton {
                                text: "Admin panel";
                                selected: root.settings_tab == 2;
                                box_width: 123px;
                                clicked => { root.settings_tab = 2; }
                            }
                            if root.admin_mode: SettingsTabButton {
                                text: "SteamID";
                                selected: root.settings_tab == 3;
                                box_width: 123px;
                                clicked => {
                                    root.settings_tab = 3;
                                    root.history_show(0);
                                    root.refresh_steam_ids();
                                }
                            }
                        }

                        if root.settings_tab == 0: VerticalLayout {
                            spacing: 6px;
                            SettingsRow {
                                label: "Panel opacity";
                                Slider {
                                    minimum: 0.35;
                                    maximum: 0.95;
                                    value <=> root.panel_opacity;
                                }
                            }

                            SettingsRow {
                                label: "Font size";
                                Slider {
                                    minimum: 12;
                                    maximum: 24;
                                    value <=> root.overlay_font_size;
                                }
                            }

                            SettingsRow {
                                label: "Heavy read ms";
                                Slider {
                                    minimum: 100;
                                    maximum: 1000;
                                    value <=> root.heavy_refresh_interval_ms;
                                }
                            }

                            HorizontalLayout {
                                height: 28px;
                                spacing: 18px;

                                CheckBox {
                                    text: "Movable frame";
                                    checked <=> root.overlay_frame;
                                    width: 150px;
                                }

                                Button {
                                    text: "Show overlay";
                                    width: 122px;
                                    clicked => {
                                        root.show_overlay();
                                    }
                                }

                                Button {
                                    text: "Hide overlay";
                                    width: 122px;
                                    clicked => {
                                        root.hide_overlay();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                StatToggle { text: "Gold"; checked <=> root.show_gold; }
                                StatToggle { text: "Population"; checked <=> root.show_population; }
                                StatToggle { text: "Food"; checked <=> root.show_food_effect; }
                                StatToggle { text: "Tax"; checked <=> root.show_tax_effect; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                StatToggle { text: "Popularity"; checked <=> root.show_total_effect; }
                                StatToggle { text: "Fear factor"; checked <=> root.show_ff; }
                                StatToggle { text: "Army size"; checked <=> root.show_army; }
                                StatToggle { text: "Horse archer"; checked <=> root.show_ha; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                StatToggle { text: "Camel lancer"; checked <=> root.show_cl; }
                                StatToggle { text: "Knights"; checked <=> root.show_knights; }
                                StatToggle { text: "Shooters"; checked <=> root.show_shooters; }
                                StatToggle { text: "Army killed"; checked <=> root.show_army_killed; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                StatToggle { text: "Army lost"; checked <=> root.show_army_lost; }
                                StatToggle { text: "Acquired Gold"; checked <=> root.show_acq_gold; }
                                StatToggle { text: "Produced Food"; checked <=> root.show_prod_food; }
                                StatToggle { text: "Produced Weapons"; checked <=> root.show_prod_weapons; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                StatToggle { text: "Produced Stone"; checked <=> root.show_prod_stone; }
                                StatToggle { text: "Produced Iron"; checked <=> root.show_prod_iron; }
                                StatToggle { text: "Produced Wood"; checked <=> root.show_prod_wood; }
                            }

                            Rectangle {
                                width: 24px;
                                height: 10px;
                                background: transparent;
                            }    

                            Text {
                                text: "Shooter types (required 'Shooters')";
                                color: #434750;
                                font-size: 12px;
                                font-weight: 800;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                StatToggle { text: "Horse archer"; checked <=> root.show_ha;}
                                StatToggle { text: "Skirmisher"; checked <=> root.shooter_count_skirmishers; }
                                StatToggle { text: "European Archer"; checked <=> root.shooter_count_archers; }
                                StatToggle { text: "Arabian archer"; checked <=> root.shooter_count_arab_bows; }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                StatToggle { text: "Crossbow"; checked <=> root.shooter_count_xbows; }
                                StatToggle { text: "Slingers"; checked <=> root.shooter_count_slingers; }
                            }
                        }

                        if root.settings_tab == 1: VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                height: 30px;
                                spacing: 10px;

                                FieldLabel {
                                    text: "Game speed";
                                    width: 98px;
                                }

                                Button {
                                    text: "-";
                                    width: 34px;
                                    clicked => {
                                        root.game_speed = max(10, root.game_speed - 5);
                                    }
                                }

                                Text {
                                    text: root.game_speed;
                                    color: #111827;
                                    font-size: 12px;
                                    font-weight: 800;
                                    width: 48px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                Button {
                                    text: "+";
                                    width: 34px;
                                    clicked => {
                                        root.game_speed = min(90, root.game_speed + 5);
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 10px;

                                FieldLabel {
                                    text: "Player id";
                                    width: 98px;
                                }

                                Button {
                                    text: "<";
                                    width: 34px;
                                    clicked => {
                                        root.timer_player_id = max(1, root.timer_player_id - 1);
                                    }
                                }

                                Text {
                                    text: root.timer_player_id;
                                    color: #111827;
                                    font-size: 12px;
                                    font-weight: 800;
                                    width: 48px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                Button {
                                    text: ">";
                                    width: 34px;
                                    clicked => {
                                        root.timer_player_id = min(8, root.timer_player_id + 1);
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                StatToggle {
                                    text: "Buildings";
                                    checked <=> root.timer_show_buildings;
                                }
                            }
                            SettingsRow {
                                label: "Font size";
                                Slider {
                                    minimum: 12;
                                    maximum: 18;
                                    value <=> root.timer_font_size;
                                }
                            }
                            SettingsRow {
                                label: "Panel opacity";
                                Slider {
                                    minimum: 0.35;
                                    maximum: 0.95;
                                    value <=> root.timer_panel_opacity;
                                }
                            }
                            HorizontalLayout {
                                height: 28px;
                                spacing: 18px;
                                CheckBox {
                                    text: "Movable frame";
                                    checked <=> root.timer_frame;
                                    width: 150px;
                                }
                                Button {
                                    text: "Show timer";
                                    width: 122px;
                                    clicked => { root.show_timer(); }
                                }
                                Button {
                                    text: "Hide timer";
                                    width: 122px;
                                    clicked => { root.hide_timer(); }
                                }
                            }
                        }

                        if root.settings_tab == 2 && root.admin_mode: VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Admin panel";
                                color: #111827;
                                font-size: 14px;
                                font-weight: 800;
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 10px;

                                FieldLabel {
                                    text: "UI player id";
                                    width: 98px;
                                }

                                Text {
                                    text: "Game P" + root.admin_game_player_id;
                                    color: #4b5563;
                                    font-size: 12px;
                                    font-weight: 800;
                                    width: 78px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                Button {
                                    text: "<";
                                    width: 34px;
                                    clicked => {
                                        root.request_admin_ui_player(max(1, root.admin_ui_player_id - 1));
                                    }
                                }

                                Text {
                                    text: root.admin_ui_player_id;
                                    color: #111827;
                                    font-size: 12px;
                                    font-weight: 800;
                                    width: 48px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                Button {
                                    text: ">";
                                    width: 34px;
                                    clicked => {
                                        root.request_admin_ui_player(min(8, root.admin_ui_player_id + 1));
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 28px;
                                spacing: 18px;

                                CheckBox {
                                    text: "Movable frame";
                                    checked <=> root.admin_frame;
                                    width: 150px;
                                }

                                Button {
                                    text: "Show admin";
                                    width: 122px;
                                    clicked => { root.show_admin(); }
                                }

                                Button {
                                    text: "Hide admin";
                                    width: 122px;
                                    clicked => { root.hide_admin(); }
                                }
                            }
                        }
                        if root.settings_tab == 3 && root.admin_mode: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: "Steam player IDs";
                                color: #111827;
                                font-size: 14px;
                                font-weight: 800;
                            }
                            Text {
                                text: "SteamID64 and profile links for players in the current or last multiplayer match.";
                                color: #4b5563;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Button {
                                text: "Refresh Steam IDs";
                                height: 28px;
                                clicked => { root.refresh_steam_ids(); }
                            }
                            Text {
                                text: root.steam_id_status;
                                color: #647084;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                if !(root.settings_tab == 3 && root.admin_mode): PlayerTable {
                    player_rows: root.player_rows;
                    width: parent.width;
                    height: parent.height;
                }
                if root.settings_tab == 3 && root.admin_mode: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 10px;
                    if root.history_view == 0: SteamIdTable {
                        rows: root.steam_id_rows;
                        status: root.steam_id_status;
                        open-profile(player-id, steam-id) => { root.open_steam_profile(player-id, steam-id); }
                    }
                    if root.history_view != 0: HistoryWorkspace {
                        view: root.history_view;
                        search <=> root.history_search;
                        filter <=> root.history_filter;
                        games: root.game_history_rows;
                        players: root.player_journal_rows;
                        list-status: root.history_list_status;
                        detail-title: root.history_detail_title;
                        detail-summary: root.history_detail_summary;
                        detail-fields: root.history_detail_fields;
                        roster: root.history_roster_rows;
                        known-names: root.history_player_names;
                        player-games: root.history_player_games;
                        detail-steam-id: root.history_detail_steam_id;
                        show(view) => { root.history_show(view); }
                        search-changed(value) => { root.history_search_changed(value); }
                        filter-changed(value) => { root.history_filter_changed(value); }
                        open-game(id) => { root.history_open_game(id); }
                        open-player(id) => { root.history_open_player(id); }
                        open-profile(id) => { root.history_open_player_profile(id); }
                        refresh => { root.history_refresh(); }
                    }
                    if root.history_view == 0 && root.history_current_summary != "": Text {
                        text: root.history_current_summary;
                        color: #4b5563;
                        font-size: 12px;
                        wrap: word-wrap;
                        height: min(76px, self.preferred-height + 6px);
                        overflow: elide;
                    }
                    Rectangle {
                        height: 116px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-color: #dde3ee;
                        border-width: 1px;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                Button { text: "Update player journal"; width: 176px; clicked => { root.history_rebuild_players(); } }
                                Button { text: "Games"; width: 72px; clicked => { root.history_show(1); } }
                                Button { text: "Players"; width: 72px; clicked => { root.history_show(2); } }
                                if root.history_view != 0: Button { text: "SteamID"; width: 80px; clicked => { root.history_show(0); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                Button { text: "Export games…"; width: 116px; clicked => { root.history_export(); } }
                                Button { text: "Import games…"; width: 116px; clicked => { root.history_import(); } }
                                Button { text: "Open games folder"; width: 142px; clicked => { root.history_open_folder(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HistoryText { text: root.history_status; color: #647084; height: 20px; }
                        }
                    }
                    if root.history_import_pending: Rectangle {
                        height: 142px;
                        background: #fff8e8;
                        border-width: 1px;
                        border-color: #e1c78e;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Text {
                                text: root.history_import_preview;
                                color: #614b20;
                                font-size: 12px;
                                wrap: word-wrap;
                                vertical-stretch: 1;
                            }
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                Button { text: "Apply import"; width: 120px; clicked => { root.history_confirm_import(); } }
                                Button { text: "Cancel"; width: 90px; clicked => { root.history_cancel_import(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component OverlayWindow inherits Window {
    in property <[PlayerUiRow]> player_rows;
    in-out property <[OverlayColumnUi]> columns;
    in-out property <[OverlayColumnUi]> hidden-columns;
    in-out property <[OverlayRowUi]> overlay-rows;
    in-out property <[string]> column-order;
    in-out property <string> column-signature;
    in-out property <bool> editing;
    in-out property <string> selected-column;
    in-out property <bool> dragging;
    in-out property <string> drag-label;
    in-out property <image> drag-icon;
    in-out property <float> drop-position: -1;
    in-out property <string> edit-status;
    in property <float> statistics-width;
    in property <float> column-gap: 6;
    in property <string> tournament_title: "Title";
    in property <string> match_label: "Description";
    in property <float> panel_opacity: 0.78;
    in property <float> overlay_font_size: 16;
    in property <bool> overlay_frame: true;
    in property <bool> pin_on_top: false;

    private property <bool> add-open;
    private property <length> player-width: max(120px, root.overlay_font_size * 7.5px);
    private property <length> row-height: max(28px, root.overlay_font_size * 1.9px);
    private property <length> header-height: max(16px, root.overlay_font_size * 1.05px) + (root.editing ? 18px : 0px);
    private property <length> table-height: root.header-height + root.overlay-rows.length * (root.row-height + 5px) + 16px;
    private property <length> ghost-x;
    private property <string> tooltip-text;
    private property <length> tooltip-x;
    private property <length> tooltip-y;
    private property <bool> tooltip-open;
    private property <string> pressed-remove-column;

    callback hide_overlay();
    callback request_overlay_frame(bool);
    callback request-editing(bool);
    callback select-column(string);
    callback move-column(int);
    callback set-column-visible(string, bool);
    callback reset-column-order();
    callback begin-column-drag(float);
    callback update-column-drag(float);
    callback finish-column-drag(float, bool);
    callback cancel-column-drag();
    pure callback header-title-at(float) -> string;
    pure callback header-remove-at(float) -> string;

    title: "Stronghold Crusader DE, Monitor";
    icon: @image-url("../assets/icon.png");
    always-on-top: root.pin_on_top;
    no-frame: !root.overlay_frame;
    background: transparent;
    width: min(1600px, max(root.editing ? 720px : 430px, root.player-width + root.column-gap * 1px + root.statistics-width * 1px + 14px));
    height: 14px + max(32px, root.overlay_font_size * 1.8px) + 5px + root.table-height + (root.editing ? 85px : 0px) + (root.editing && root.add-open ? 190px : 0px);
    forward-focus: editor-focus;

    changed editing => {
        root.add-open = false;
        root.pressed-remove-column = "";
        root.hide-tooltip();
        if (root.editing) { editor-focus.focus(); }
    }

    changed column-signature => { root.pressed-remove-column = ""; root.hide-tooltip(); }

    function hide-tooltip() {
        tooltip-delay.stop();
        root.tooltip-open = false;
        root.tooltip-text = "";
    }

    function queue-tooltip(text: string, x: float, y: float) {
        if (text == "") {
            // A delayed leave from the previous cell must not cancel the new cell's card.
            if ((x == 0 && y == 0) || (abs(root.tooltip-x - x * 1px) < 1px && abs(root.tooltip-y - y * 1px) < 1px)) { root.hide-tooltip(); }
        } else if (root.editing || root.dragging) {
            root.hide-tooltip();
        } else {
            if (text != root.tooltip-text) {
                root.tooltip-text = text;
            }
            if (!root.tooltip-open && !tooltip-delay.running) { tooltip-delay.start(); }
            root.tooltip-x = x * 1px;
            root.tooltip-y = y * 1px;
        }
    }

    tooltip-delay := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            tooltip-delay.stop();
            root.tooltip-open = root.tooltip-text != "" && !root.editing && !root.dragging;
        }
    }

    editor-focus := FocusScope {
        focus-lost(reason) => { root.pressed-remove-column = ""; root.hide-tooltip(); root.cancel-column-drag(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-column-drag();
                root.pressed-remove-column = "";
                root.hide-tooltip();
                root.add-open = false;
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        border-radius: 8px;
        background: rgba(13, 18, 27, root.panel_opacity);
        border-color: rgba(255, 255, 255, 0.14);
        border-width: 1px;

        VerticalLayout {
            padding: 7px;
            spacing: 5px;

            HorizontalLayout {
                height: max(32px, root.overlay_font_size * 1.8px);
                spacing: 5px;
                VerticalLayout {
                    spacing: 0px;
                    Text {
                        text: root.tournament_title;
                        color: #f8fafc;
                        font-size: max(11px, root.overlay_font_size * 0.82px);
                        font-weight: 800;
                        overflow: elide;
                    }
                    Text {
                        text: root.match_label;
                        color: #cbd5e1;
                        font-size: max(9px, root.overlay_font_size * 0.62px);
                        overflow: elide;
                    }
                }
                OverlayEditorButton {
                    text: root.editing ? "Done" : "Edit columns";
                    active: root.editing;
                    width: 92px;
                    clicked => { root.request-editing(!root.editing); }
                }
                OverlayEditorButton {
                    text: "Hide";
                    width: 50px;
                    clicked => { root.cancel-column-drag(); root.hide_overlay(); }
                }
                OverlayEditorButton {
                    text: root.overlay_frame ? "Frame on" : "Frame off";
                    width: 76px;
                    clicked => { root.cancel-column-drag(); root.request_overlay_frame(!root.overlay_frame); }
                }
            }

            if root.editing: HorizontalLayout {
                height: 28px;
                spacing: 6px;
                OverlayEditorButton {
                    text: root.add-open ? "Close list" : "+ Add column";
                    width: 110px;
                    active: root.add-open;
                    clicked => { root.cancel-column-drag(); root.add-open = !root.add-open; }
                }
                Text {
                    text: root.selected-column == "" ? "Select a header" : "Selected column";
                    color: #cbd5e1;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                OverlayEditorButton {
                    text: "Move left";
                    width: 78px;
                    enabled: root.selected-column != "";
                    clicked => { root.move-column(-1); }
                }
                OverlayEditorButton {
                    text: "Move right";
                    width: 78px;
                    enabled: root.selected-column != "";
                    clicked => { root.move-column(1); }
                }
                OverlayEditorButton {
                    text: "Hide column";
                    width: 88px;
                    enabled: root.selected-column != "";
                    clicked => { root.set-column-visible(root.selected-column, false); }
                }
                OverlayEditorButton {
                    text: "Reset order";
                    width: 88px;
                    clicked => { root.reset-column-order(); }
                }
            }

            if root.editing && root.add-open: Rectangle {
                height: 185px;
                border-radius: 4px;
                background: #172231;
                border-width: 1px;
                border-color: #465366;
                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;
                    Text {
                        height: 18px;
                        text: root.hidden-columns.length == 0 ? "All statistics are already shown." : "Add after the selected column, or at the end when none is selected.";
                        color: #cbd5e1;
                        font-size: 11px;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        for category in ["Economy", "Army", "Production"]: VerticalLayout {
                            spacing: 5px;
                            Text { text: category; color: #f8fafc; font-size: 12px; font-weight: 700; height: 18px; }
                            ScrollView {
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout {
                                    spacing: 0px;
                                    for column in root.hidden-columns: Rectangle {
                                        height: column.group == category ? 30px : 0px;
                                        visible: column.group == category;
                                        OverlayEditorButton {
                                            height: 26px;
                                            text: "+  " + column.full-title;
                                            clicked => { root.set-column-visible(column.id, true); }
                                        }
                                        Image { x: 6px; y: 5px; width: 16px; height: 16px; source: column.icon; image-fit: contain; }
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }
                }
            }

            if root.editing: Text {
                height: 18px;
                text: "Drag a header to move it. × hides it. Player stays first. Changes save automatically.";
                color: #b9c7d9;
                font-size: 11px;
                vertical-alignment: center;
            }

            table := Rectangle {
                height: root.table-height;
                clip: true;
                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: root.player-width;
                    height: root.table-height;
                    spacing: 5px;
                    CompactLabel {
                        text: root.editing ? "Player · fixed" : "Player";
                        overlay_font_size: root.overlay_font_size;
                        height: root.header-height;
                    }
                    for row in root.overlay-rows: CompactValue {
                        height: root.row-height;
                        text: row.name;
                        color: row.name-color;
                        horizontal-alignment: left;
                        overflow: elide;
                        overlay_font_size: root.overlay_font_size;
                    }
                    Rectangle { height: 11px; }
                }

                statistics := ScrollView {
                    x: root.player-width + root.column-gap * 1px;
                    width: parent.width - self.x;
                    viewport-width: max(self.visible-width, root.statistics-width * 1px);
                    viewport-height: self.visible-height;
                    vertical-scrollbar-policy: always-off;
                    Rectangle {
                        width: max(statistics.visible-width, root.statistics-width * 1px);
                        height: statistics.visible-height;
                        VerticalLayout {
                            spacing: 5px;
                            header := Rectangle {
                                height: root.header-height;
                                HorizontalLayout {
                                    spacing: root.column-gap * 1px;
                                    alignment: start;
                                    for column in root.columns: Rectangle {
                                        width: column.column-width * 1px;
                                        horizontal-stretch: 0;
                                        border-radius: 3px;
                                        border-width: root.editing && root.selected-column == column.id ? 1px : 0px;
                                        border-color: #8da6c5;
                                        background: root.editing && root.selected-column == column.id ? #28394d : transparent;
                                        OverlayStatHeader {
                                            y: root.editing ? 18px : 0px;
                                            height: parent.height - self.y;
                                            text: column.title;
                                            icon: column.icon;
                                            overlay_font_size: root.overlay_font_size;
                                        }
                                        if root.editing: Rectangle {
                                            x: 4px;
                                            y: 4px;
                                            width: 6px;
                                            height: 10px;
                                            for dot in [{x: 0, y: 0}, {x: 4, y: 0}, {x: 0, y: 4}, {x: 4, y: 4}, {x: 0, y: 8}, {x: 4, y: 8}]: Rectangle {
                                                x: dot.x * 1px;
                                                y: dot.y * 1px;
                                                width: 2px;
                                                height: 2px;
                                                border-radius: 1px;
                                                background: #8da6c5;
                                            }
                                        }
                                        if root.editing: Rectangle {
                                            x: parent.width - 18px;
                                            y: 0px;
                                            width: 18px;
                                            height: 18px;
                                            Text {
                                                text: "×";
                                                color: header-touch.has-hover && header-touch.mouse-y < 18px && root.header-remove-at(header-touch.mouse-x / 1px) == column.id ? #f28c88 : #a8b6c8;
                                                horizontal-alignment: center;
                                                font-size: 14px;
                                            }
                                        }
                                    }
                                }

                                // This capture surface stays alive while player values refresh.
                                header-touch := TouchArea {
                                    height: parent.height;
                                    mouse-cursor: !root.editing ? MouseCursor.default : self.mouse-y < 18px && root.header-remove-at(self.mouse-x / 1px) != "" ? MouseCursor.pointer : MouseCursor.grab;
                                    changed has-hover => {
                                        if (!self.has-hover) {
                                            root.queue-tooltip("", (self.absolute-position.x + self.mouse-x) / 1px, self.absolute-position.y / 1px);
                                        }
                                    }
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.move && !root.editing && !self.pressed) {
                                            if (root.header-title-at(self.mouse-x / 1px) == "") {
                                                root.hide-tooltip();
                                            } else {
                                                root.queue-tooltip(root.header-title-at(self.mouse-x / 1px), (self.absolute-position.x + self.mouse-x) / 1px, self.absolute-position.y / 1px);
                                            }
                                        }
                                        if (event.kind == PointerEventKind.down) { root.hide-tooltip(); }
                                        if (root.editing && event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            editor-focus.focus();
                                            root.ghost-x = self.mouse-x;
                                            root.pressed-remove-column = self.mouse-y < 18px ? root.header-remove-at(self.mouse-x / 1px) : "";
                                            if (root.pressed-remove-column == "") { root.begin-column-drag(self.mouse-x / 1px); }
                                        }
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                            if (root.pressed-remove-column != "") {
                                                if (self.mouse-y >= 0px && self.mouse-y < 18px && self.mouse-x >= -statistics.viewport-x && self.mouse-x <= -statistics.viewport-x + statistics.visible-width && root.header-remove-at(self.mouse-x / 1px) == root.pressed-remove-column) {
                                                    root.set-column-visible(root.pressed-remove-column, false);
                                                }
                                                root.pressed-remove-column = "";
                                            } else {
                                                root.finish-column-drag(self.mouse-x / 1px, self.mouse-y >= 0px && self.mouse-y <= self.height && self.mouse-x >= -statistics.viewport-x && self.mouse-x <= -statistics.viewport-x + statistics.visible-width);
                                            }
                                        }
                                        if (event.kind == PointerEventKind.cancel) { root.pressed-remove-column = ""; root.cancel-column-drag(); }
                                    }
                                    moved => {
                                        if (self.pressed && root.pressed-remove-column == "") {
                                            root.ghost-x = self.mouse-x;
                                            root.update-column-drag(self.mouse-x / 1px);
                                        }
                                    }
                                }


                                if root.dragging && root.drop-position >= 0: Rectangle {
                                    x: root.drop-position * 1px;
                                    width: 2px;
                                    background: #76d29a;
                                }
                                if root.dragging: Rectangle {
                                    x: max(0px, min(parent.width - self.width, root.ghost-x - 45px));
                                    y: -3px;
                                    width: 110px;
                                    height: root.header-height + 6px;
                                    border-radius: 4px;
                                    background: #34485f;
                                    border-width: 1px;
                                    border-color: #a5b8cd;
                                    OverlayStatHeader { x: 6px; width: parent.width - 12px; text: root.drag-label; icon: root.drag-icon; overlay_font_size: root.overlay_font_size; }
                                }
                            }
                            for row in root.overlay-rows: Rectangle {
                                height: root.row-height;
                                HorizontalLayout {
                                    spacing: root.column-gap * 1px;
                                    alignment: start;
                                    for cell[index] in row.cells: OverlayStatValue {
                                        width: root.columns[index].column-width * 1px;
                                        horizontal-stretch: 0;
                                        text: cell.text;
                                        value-color: cell.value-color;
                                        overlay-font-size: root.overlay_font_size;
                                        hover-enabled: !root.editing;
                                        hover-info(text, x, y) => { root.queue-tooltip(text, x, y); }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }

            if root.editing: Text {
                height: 19px;
                text: root.edit-status;
                color: #cbd5e1;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // This card has no input surface, so it cannot interrupt column dragging.
        if root.tooltip-open: Rectangle {
            x: max(4px, min(root.width - self.width - 4px, root.tooltip-x - self.width / 2));
            y: max(4px, root.tooltip-y - self.height - 5px);
            width: min(root.width - 8px, tooltip-label.preferred-width + 16px);
            height: 27px;
            border-radius: 4px;
            border-width: 1px;
            border-color: #718198;
            background: #233246;
            tooltip-label := Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.tooltip-text;
                color: #f8fafc;
                font-size: 12px;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}


export component TimerWindow inherits Window {
    in property <float> panel_opacity: 0.78;
    in property <float> timer_font_size: 16;
    in property <bool> timer_frame: true;
    in property <bool> pin_on_top: false;
    in property <string> ticks_text: "0";
    in property <string> day_text: "1";
    in property <string> month_text: "Jul";
    in property <string> year_text: "1181";
    in property <string> elapsed_text: "00:00";
    in property <string> game_speed_text: "50";
    in property <string> timer_player_text: "P1";
    in property <bool> scenario_mode: false;
    in property <string> acquired_gold_text: "0";
    in property <string> produced_food_text: "0";
    in property <string> produced_stone_text: "0";
    in property <string> produced_iron_text: "0";
    in property <string> produced_wood_text: "0";
    in property <string> produced_weapons_text: "0";
    in property <bool> show_buildings: false;
    in property <int> fletchers_count: 0;
    in property <int> poleturners_count: 0;
    in property <int> armourers_count: 0;
    in property <int> blacksmiths_count: 0;
    in property <int> bakers_count: 0;
    in property <int> mills_count: 0;
    in property <int> woodcutters_count: 0;
    private property <float> timer_width_scale: max(1, root.timer_font_size / 12);
    private property <length> timer_ticks_width: 78px * root.timer_width_scale;
    private property <length> timer_day_width: 25px * root.timer_width_scale;
    private property <length> timer_month_width: 30px * root.timer_width_scale;
    private property <length> timer_year_width: 30px * root.timer_width_scale;
    private property <length> timer_time_width: 50px * root.timer_width_scale;
    private property <length> timer_gs_width: 32px * root.timer_width_scale;
    private property <length> timer_acq_gold_width: 70px * root.timer_width_scale;
    private property <length> timer_prod_food_width: 50px * root.timer_width_scale;
    private property <length> timer_prod_stone_width: 50px * root.timer_width_scale;
    private property <length> timer_prod_iron_width: 50px * root.timer_width_scale;
    private property <length> timer_prod_wood_width: 50px * root.timer_width_scale;
    private property <length> timer_prod_weapons_width: 50px * root.timer_width_scale;
    private property <length> timer_building_width: 50px * root.timer_width_scale;
    private property <length> timer_buildings_width: root.show_buildings ? (root.timer_building_width * 7 + 70px) : 0px;

    callback hide_timer();
    callback request_timer_frame(bool);
    callback request_timer_player(int);
    callback request_scenario_mode(bool);

    title: "Game ticks timer";
    icon: @image-url("../assets/icon.png");
    always-on-top: root.pin_on_top;
    no-frame: !root.timer_frame;
    background: transparent;
    width: max(520px, root.timer_ticks_width + root.timer_day_width + root.timer_month_width + root.timer_year_width + root.timer_time_width + root.timer_gs_width + root.timer_acq_gold_width + root.timer_prod_food_width + root.timer_prod_stone_width + root.timer_prod_iron_width + root.timer_prod_wood_width + root.timer_prod_weapons_width + root.timer_buildings_width + 150px);
    height: max(95px, root.timer_font_size * 6.8px);

    Rectangle {
        background: transparent;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-radius: 8px;
            background: rgba(13, 18, 27, root.panel_opacity);
            border-color: rgba(255, 255, 255, 0.14);
            border-width: 1px;
        }

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            HorizontalLayout {
                height: max(26px, root.timer_font_size * 1.3px);
                spacing: 6px;

                Text {
                    text: "Game ticks timer";
                    color: #f8fafc;
                    font-size: root.timer_font_size * 1px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Button {
                    text: "<";
                    width: 32px;
                    height: 24px;
                    clicked => { root.request_timer_player(-1); }
                }

                Text {
                    text: root.timer_player_text;
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 800;
                    width: 48px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Button {
                    text: ">";
                    width: 32px;
                    height: 24px;
                    clicked => { root.request_timer_player(1); }
                }

                Rectangle {
                    width: 82px;
                    height: 24px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: root.scenario_mode ? #0b65c9 : rgba(255, 255, 255, 0.20);
                    background: root.scenario_mode ? #0b65c9 : rgba(255, 255, 255, 0.08);

                    Text {
                        text: "Scenario";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.request_scenario_mode(!root.scenario_mode);
                        }
                    }
                }

                Button {
                    text: "Hide";
                    width: 54px;
                    height: 24px;
                    clicked => { root.hide_timer(); }
                }

                Button {
                    text: root.timer_frame ? "Frame on" : "Frame off";
                    width: 82px;
                    height: 24px;
                    clicked => { root.request_timer_frame(!root.timer_frame); }
                }
            }

            HorizontalLayout {
                height: max(18px, root.timer_font_size * 1.1px);
                spacing: 10px;
                CompactLabel { text: "Ticks"; overlay_font_size: root.timer_font_size; width: root.timer_ticks_width; horizontal-alignment: right; }
                CompactLabel { text: "Day"; overlay_font_size: root.timer_font_size; width: root.timer_day_width; horizontal-alignment: right; }
                CompactLabel { text: "Month"; overlay_font_size: root.timer_font_size; width: root.timer_month_width; horizontal-alignment: right; }
                CompactLabel { text: "Year"; overlay_font_size: root.timer_font_size; width: root.timer_year_width; horizontal-alignment: right; }
                CompactLabel { text: "Time"; overlay_font_size: root.timer_font_size; width: root.timer_time_width; horizontal-alignment: right; }
                CompactLabel { text: "GS"; overlay_font_size: root.timer_font_size; width: root.timer_gs_width; horizontal-alignment: right; }
                CompactLabel { text: "Acq. Gold"; overlay_font_size: root.timer_font_size; width: root.timer_acq_gold_width; horizontal-alignment: right; }
                CompactLabel { text: "Prod. Food"; overlay_font_size: root.timer_font_size; width: root.timer_prod_food_width; horizontal-alignment: right; }
                CompactLabel { text: "Prod. Stone"; overlay_font_size: root.timer_font_size; width: root.timer_prod_stone_width; horizontal-alignment: right; }
                CompactLabel { text: "Prod. Iron"; overlay_font_size: root.timer_font_size; width: root.timer_prod_iron_width; horizontal-alignment: right; }
                CompactLabel { text: "Prod. Wood"; overlay_font_size: root.timer_font_size; width: root.timer_prod_wood_width; horizontal-alignment: right; }
                CompactLabel { text: "Prod. Weap"; overlay_font_size: root.timer_font_size; width: root.timer_prod_weapons_width; horizontal-alignment: right; }
                if root.show_buildings: CompactLabel { text: "Fletch"; overlay_font_size: root.timer_font_size; width: root.timer_building_width; horizontal-alignment: right; }
                if root.show_buildings: CompactLabel { text: "Pole"; overlay_font_size: root.timer_font_size; width: root.timer_building_width; horizontal-alignment: right; }
                if root.show_buildings: CompactLabel { text: "Armour"; overlay_font_size: root.timer_font_size; width: root.timer_building_width; horizontal-alignment: right; }
                if root.show_buildings: CompactLabel { text: "Smith"; overlay_font_size: root.timer_font_size; width: root.timer_building_width; horizontal-alignment: right; }
                if root.show_buildings: CompactLabel { text: "Baker"; overlay_font_size: root.timer_font_size; width: root.timer_building_width; horizontal-alignment: right; }
                if root.show_buildings: CompactLabel { text: "Mill"; overlay_font_size: root.timer_font_size; width: root.timer_building_width; horizontal-alignment: right; }
                if root.show_buildings: CompactLabel { text: "Wood"; overlay_font_size: root.timer_font_size; width: root.timer_building_width; horizontal-alignment: right; }
            }

            HorizontalLayout {
                height: max(28px, root.timer_font_size * 1.7px);
                spacing: 10px;
                CompactValue { text: root.ticks_text; overlay_font_size: root.timer_font_size; width: root.timer_ticks_width; }
                CompactValue { text: root.day_text; overlay_font_size: root.timer_font_size; width: root.timer_day_width; }
                CompactValue { text: root.month_text; overlay_font_size: root.timer_font_size; width: root.timer_month_width; }
                CompactValue { text: root.year_text; overlay_font_size: root.timer_font_size; width: root.timer_year_width; }
                CompactValue { text: root.elapsed_text; overlay_font_size: root.timer_font_size; width: root.timer_time_width; }
                CompactValue { text: root.game_speed_text; overlay_font_size: root.timer_font_size; width: root.timer_gs_width; }
                CompactValue { text: root.acquired_gold_text; overlay_font_size: root.timer_font_size; width: root.timer_acq_gold_width; }
                CompactValue { text: root.produced_food_text; overlay_font_size: root.timer_font_size; width: root.timer_prod_food_width; }
                CompactValue { text: root.produced_stone_text; overlay_font_size: root.timer_font_size; width: root.timer_prod_stone_width; }
                CompactValue { text: root.produced_iron_text; overlay_font_size: root.timer_font_size; width: root.timer_prod_iron_width; }
                CompactValue { text: root.produced_wood_text; overlay_font_size: root.timer_font_size; width: root.timer_prod_wood_width; }
                CompactValue { text: root.produced_weapons_text; overlay_font_size: root.timer_font_size; width: root.timer_prod_weapons_width; }
                if root.show_buildings: CompactValue { text: root.fletchers_count; overlay_font_size: root.timer_font_size; width: root.timer_building_width; }
                if root.show_buildings: CompactValue { text: root.poleturners_count; overlay_font_size: root.timer_font_size; width: root.timer_building_width; }
                if root.show_buildings: CompactValue { text: root.armourers_count; overlay_font_size: root.timer_font_size; width: root.timer_building_width; }
                if root.show_buildings: CompactValue { text: root.blacksmiths_count; overlay_font_size: root.timer_font_size; width: root.timer_building_width; }
                if root.show_buildings: CompactValue { text: root.bakers_count; overlay_font_size: root.timer_font_size; width: root.timer_building_width; }
                if root.show_buildings: CompactValue { text: root.mills_count; overlay_font_size: root.timer_font_size; width: root.timer_building_width; }
                if root.show_buildings: CompactValue { text: root.woodcutters_count; overlay_font_size: root.timer_font_size; width: root.timer_building_width; }
            }
        }
    }
}

export component AdminWindow inherits Window {
    in property <float> panel_opacity: 0.78;
    in property <float> admin_font_size: 16;
    in property <bool> admin_frame: true;
    in property <bool> pin_on_top: false;
    in property <string> game_player_text: "P1";
    in property <string> selected_player_text: "P1";
    in property <string> gold_text: "0";
    in property <string> population_text: "0";
    in property <string> army_text: "0";
    in property <string> ff_text: "0";
    in property <string> acquired_gold_text: "0";
    in property <string> produced_food_text: "0";
    in property <string> produced_stone_text: "0";
    in property <string> produced_iron_text: "0";
    in property <string> produced_wood_text: "0";
    in property <string> produced_weapons_text: "0";
    private property <float> admin_width_scale: max(1, root.admin_font_size / 12);
    private property <length> admin_small_width: 48px * root.admin_width_scale;
    private property <length> admin_mid_width: 66px * root.admin_width_scale;
    private property <length> admin_big_width: 76px * root.admin_width_scale;

    callback hide_admin();
    callback request_admin_frame(bool);
